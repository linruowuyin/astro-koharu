# 博客工具的构建产物：exe 有 50MB，截图和测试输出也不该进仓库。
# 源码在 tools/BlogTool/，用 dotnet publish 重新生成：
#   dotnet publish tools/BlogTool -c Release -r win-x64 --self-contained true \
#     -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true
tools/BlogTool/bin/
tools/BlogTool/obj/
tools/BlogTool/publish/
tools/BlogTool/test/bin/
tools/BlogTool/test/obj/
tools/BlogTool/test/shots/
tools/BlogTool/test/*.txt
# 编译好的工具本体放在项目根目录，直接双击就能用
/博客工具.exe

# Transformers.js model cache
.cache/*
# Keep OG data cache for Vercel builds
!.cache/og-data.json

# Backup files
backups/
