---
// src/components/layout/StockBar.astro
---
<div class="stock-bar" id="stock-bar" data-state="loading" aria-label="行情条"></div>

<script is:inline>
  (function () {
    // 按北京时间判断时段：09:00-16:00 显示 A 股 / 港股，其余显示美股。
    // 纯本地计算，不依赖任何外部时间接口（早期版本请求淘宝接口，跨境
    // ERR_CONNECTION_CLOSED 且挂起 10 秒以上，直接把行情条拖成空白）。
    var bjHour = (new Date().getUTCHours() + 8) % 24;
    var isDayTime = bjHour >= 9 && bjHour < 16;

    // 东方财富行情接口。返回 Access-Control-Allow-Origin，可直接 fetch。
    // f1=小数位数 f2=最新价 f3=涨跌幅 f4=涨跌额 f12=代码 f14=名称
    var GROUPS = {
      cn: [
        { id: '1.000001', name: '上证指数', url: 'https://quote.eastmoney.com/zs000001.html' },
        { id: '0.399001', name: '深证成指', url: 'https://quote.eastmoney.com/zs399001.html' },
        { id: '1.000300', name: '沪深300', url: 'https://quote.eastmoney.com/zs000300.html' },
        { id: '0.399006', name: '创业板指', url: 'https://quote.eastmoney.com/zs399006.html' },
        { id: '100.HSI', name: '恒生指数', url: 'https://quote.eastmoney.com/HKHSI.html' }
      ],
      us: [
        { id: '100.DJIA', name: '道琼斯', url: 'https://quote.eastmoney.com/gb/zsDJIA.html' },
        { id: '100.NDX', name: '纳斯达克', url: 'https://quote.eastmoney.com/gb/zsNDX.html' },
        { id: '100.SPX', name: '标普500', url: 'https://quote.eastmoney.com/gb/zsSPX.html' },
        { id: '100.HSI', name: '恒生指数', url: 'https://quote.eastmoney.com/HKHSI.html' },
        { id: '1.000001', name: '上证指数', url: 'https://quote.eastmoney.com/zs000001.html' }
      ]
    };

    var list = isDayTime ? GROUPS.cn : GROUPS.us;
    var REFRESH_MS = 60000;

    function fmt(value, digits) {
      return value.toLocaleString('zh-CN', {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits
      });
    }

    function itemHtml(item, row) {
      var p = Math.pow(10, row.f1 || 0);
      var price = row.f2 / p;
      var changePct = row.f3 / 100;
      var cls = changePct > 0 ? 'is-up' : changePct < 0 ? 'is-down' : 'is-flat';
      var arrow = changePct > 0 ? '▲' : changePct < 0 ? '▼' : '—';
      return (
        '<a class="stock-bar__item" href="' + item.url + '" target="_blank" rel="noopener noreferrer">' +
          '<span class="stock-bar__name">' + row.f14 + '</span>' +
          '<span class="stock-bar__price">' + fmt(price, 2) + '</span>' +
          '<span class="stock-bar__change ' + cls + '">' + arrow + ' ' + fmt(Math.abs(changePct), 2) + '%</span>' +
        '</a>'
      );
    }

    function render(bar, rows) {
      bar._html = rows.map(function (row, i) {
        return itemHtml(list[i], row);
      }).join('');
      layout(bar);
      bar.dataset.state = 'ready';
    }

    // 内容放得下就整条居中静止显示，放不下才复制一份做无缝滚动。
    // 每次都先按单份渲染再测量，拿到的是内容本身的宽度。
    function layout(bar) {
      var html = bar._html;
      var track = bar.querySelector('.stock-bar__track');
      if (!html || !track) return;

      bar.classList.remove('stock-bar--centered', 'stock-bar--scrolling');
      track.innerHTML = html;

      if (track.offsetWidth <= bar.clientWidth) {
        bar.classList.add('stock-bar--centered');
        return;
      }

      bar.classList.add('stock-bar--scrolling');
      track.innerHTML = html + html;
    }

    function load(bar) {
      // 用 JSONP 而不是 fetch：Cloudflare 会往页面注入 rocket-loader，它会包装
      // fetch，实测在生产环境下这里直接抛 "TypeError: Failed to fetch"，
      // 而同一个接口用 curl 请求完全正常、ACAO 也正确放行。加 <script> 标签不受
      // 这层包装影响，也不依赖 CORS 预检。
      var cb = '__stockBar' + Date.now();
      var script = document.createElement('script');

      var cleanup = function () {
        if (script.parentNode) script.parentNode.removeChild(script);
        try { delete window[cb]; } catch (e) { window[cb] = undefined; }
      };

      // 8 秒没有任何回调即视为不可达，移除整条：留灰块加破图更像站点坏了。
      var timer = setTimeout(function () {
        cleanup();
        console.warn('[stock-bar] 行情接口超时未回调');
        if (bar.isConnected) bar.remove();
      }, 8000);

      window[cb] = function (json) {
        clearTimeout(timer);
        cleanup();
        try {
          var rows = json && json.data && json.data.diff;
          if (!rows || !rows.length) throw new Error('empty payload');
          render(bar, rows);
          bar._timer = setInterval(function () {
            if (bar.isConnected) load(bar);
          }, REFRESH_MS);
        } catch (err) {
          console.warn('[stock-bar] 行情数据异常:', err);
          if (bar.isConnected) bar.remove();
        }
      };

      script.onerror = function () {
        clearTimeout(timer);
        cleanup();
        console.warn('[stock-bar] 行情脚本加载失败');
        if (bar.isConnected) bar.remove();
      };

      var url =
        'https://push2.eastmoney.com/api/qt/ulist.np/get' +
        '?cb=' + cb +
        '&fields=f1,f2,f3,f4,f12,f14' +
        '&secids=' + list.map(function (s) { return s.id; }).join(',');

      script.src = url;
      document.head.appendChild(script);
    }

    function init() {
      var bar = document.getElementById('stock-bar');
      if (!bar) return;
      // 客户端路由切换会重建 Header 里的这个节点，脚本本身不会重跑，
      // 所以每次 astro:page-load 都要补一次；已就绪的节点直接跳过。
      if (bar.dataset.state === 'ready' || bar._loading) return;
      bar._loading = true;
      load(bar);
    }

    init();
    document.addEventListener('astro:page-load', init);

    // 窗口缩放会改变可用宽度，需要在「居中」和「滚动」之间重新判定。
    // 去抖是为了避免拖动窗口时反复重排。
    var resizeTimer;
    window.addEventListener('resize', function () {
      var bar = document.getElementById('stock-bar');
      if (!bar || bar.dataset.state !== 'ready') return;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        if (bar.isConnected) layout(bar);
      }, 150);
    });
  })();
</script>

<style>
  .stock-bar {
    display: block;
    width: 100%;
    height: 46px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    overflow: hidden;
    margin: 0;
    padding: 0;
    z-index: 50;
  }

  .stock-bar__track {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    height: 46px;
    padding-left: 14px;
    white-space: nowrap;
  }

  /* 内容放得下：整条居中静止，不做跑马灯 */
  .stock-bar--centered {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 放不下才滚动：复制一份，滚到 -50% 时首尾无缝衔接 */
  .stock-bar--scrolling .stock-bar__track {
    animation: stock-bar-scroll 45s linear infinite;
    will-change: transform;
  }

  .stock-bar--scrolling .stock-bar__track:hover {
    animation-play-state: paused;
  }

  .stock-bar__item {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-size: 13px;
    line-height: 1;
    color: rgb(255 255 255 / 0.92);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .stock-bar__item:hover {
    opacity: 0.7;
  }

  .stock-bar__name {
    font-weight: 600;
  }

  .stock-bar__price {
    font-variant-numeric: tabular-nums;
  }

  .stock-bar__change {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  /* A 股习惯：红涨绿跌 */
  .stock-bar__change.is-up {
    color: #f87171;
  }

  .stock-bar__change.is-down {
    color: #4ade80;
  }

  .stock-bar__change.is-flat {
    color: rgb(255 255 255 / 0.7);
  }

  @keyframes stock-bar-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stock-bar--scrolling .stock-bar__track {
      animation: none;
    }
  }
</style>
